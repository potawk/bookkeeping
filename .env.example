# .env.local にコピーして値を設定する（.env.local は Git の管理対象外）
# 値は Supabase のダッシュボード（Project Settings → API）で確認できる

# Supabase のプロジェクト URL と anon キー（アプリの実行に必要）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# デモアカウント（demo@example.com）のパスワード（npm run seed:demo でのみ使う）
DEMO_PASSWORD=
